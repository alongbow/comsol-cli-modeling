param([string]$ComsolBin = '', [switch]$Diagnose)

$ErrorActionPreference = 'Stop'
Set-StrictMode -Version Latest
$ClassName = '__CLASS_NAME__'
$ConfiguredComsolBin = '__COMSOL_BIN__'
$Root = $PSScriptRoot
$Results = Join-Path $Root 'results'
$PrefsDir = Join-Path $Root '.comsol-cli-prefs'
$Runtime = Join-Path $Root '.comsol-runtime'
$Marker = Join-Path $Results 'run_complete.marker'
$Log = Join-Path $Results 'comsol_batch.log'
. (Join-Path $Root 'resolve_comsol.ps1')

$ComsolBin = Resolve-ComsolBin -ComsolBin $ComsolBin -ConfiguredComsolBin $ConfiguredComsolBin
New-Item -ItemType Directory -Force -Path $Results, $PrefsDir,
  (Join-Path $Runtime 'tmp'), (Join-Path $Runtime 'configuration'), (Join-Path $Runtime 'workspace') | Out-Null
$common = @('-prefsdir', $PrefsDir, '-tmpdir', (Join-Path $Runtime 'tmp'))
$compileRuntime = @('-configuration', (Join-Path $Runtime 'configuration\compile_@process.id'),
                    '-data', (Join-Path $Runtime 'workspace\compile_@process.id'))
$batchRuntime = @('-configuration', (Join-Path $Runtime 'configuration\batch_@process.id'),
                  '-data', (Join-Path $Runtime 'workspace\batch_@process.id'))
$versionLog = Join-Path $Results 'comsol_version.log'
& (Join-Path $ComsolBin 'comsolbatch.exe') @common @batchRuntime -version *> $versionLog
$versionExit = $LASTEXITCODE
$versionText = (Get-Content -LiteralPath $versionLog -Raw).Trim()
$environment = [ordered]@{
  comsol_bin = $ComsolBin; version = $versionText; version_exit_code = $versionExit
  project_root = $Root; powershell = $PSVersionTable.PSVersion.ToString()
}
$environment | ConvertTo-Json | Set-Content -LiteralPath (Join-Path $Results 'comsol_environment.json') -Encoding UTF8
Write-Host "COMSOL bin: $ComsolBin"
Write-Host $versionText
if ($versionExit -ne 0) { throw "COMSOL version check failed. Inspect $versionLog" }
if ($Diagnose) {
  Write-Host "Diagnostics: $(Join-Path $Results 'comsol_environment.json') (no compilation or solve performed)"
  return
}

if (Test-Path -LiteralPath $Marker) { Remove-Item -LiteralPath $Marker -Force }
Push-Location $Root
try {
  $compileLog = Join-Path $Results 'compile.log'
  $ClassFile = Join-Path $Root "$ClassName.class"
  # Some releases return zero even when compilation failed.
  if (Test-Path -LiteralPath $ClassFile) { Remove-Item -LiteralPath $ClassFile -Force }
  & (Join-Path $ComsolBin 'comsolcompile.exe') @common @compileRuntime "$ClassName.java" *> $compileLog
  $compileExit = $LASTEXITCODE
  if (($compileExit -ne 0) -or -not (Test-Path -LiteralPath $ClassFile -PathType Leaf)) {
    Get-Content -LiteralPath $compileLog -Tail 60
    throw "Compilation produced no usable $ClassName.class (exit $compileExit). Inspect $compileLog"
  }
  $stdoutLog = Join-Path $Results 'comsol_stdout.log'
  & (Join-Path $ComsolBin 'comsolbatch.exe') @common @batchRuntime -inputfile "$ClassName.class" -nosave -batchlogout -batchlog $Log *> $stdoutLog
  $batchExitCode = $LASTEXITCODE
  if (-not (Test-Path -LiteralPath $Marker)) {
    foreach ($file in @($Log, $stdoutLog)) {
      if (Test-Path -LiteralPath $file) { Get-Content -LiteralPath $file -Tail 60 }
    }
    throw "COMSOL batch ended before completion. Inspect $Log and $stdoutLog"
  }
  if ($batchExitCode -ne 0) { Write-Warning "COMSOL returned $batchExitCode after completion; inspect $Log" }
  Write-Host "Completed. Results: $Results"
  Get-ChildItem -LiteralPath $Results | Select-Object Name, Length | Format-Table -AutoSize
} finally { Pop-Location }
